# Unidad systemd para el esquema de releases (scripts/release/release.sh).
# Siempre apunta a current/: release.sh cambia el enlace y reinicia el servicio.
# systemd resuelve el enlace al arrancar; por eso un cambio de release exige restart.
[Unit]
Description=Plataforma Elemental (Gunicorn, releases)
After=network.target postgresql.service

[Service]
Type=simple
User=root
WorkingDirectory=/srv/apps/elemental/current
EnvironmentFile=/srv/apps/elemental/shared/.env.prod
ExecStart=/srv/apps/elemental/current/.venv/bin/gunicorn --workers 3 --bind 127.0.0.1:8000 plataformaelemental.wsgi:application
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
